{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "./node-code-sandbox-mcp/src",
    "outDir": "./node-code-sandbox-mcp/dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "rewriteRelativeImportExtensions": true,
    "declaration": false,
    "sourceMap": false,
    "noUnusedLocals": false,
    "noImplicitOverride": false
  },
  "include": [
    "node-code-sandbox-mcp/src/config.ts",
    "node-code-sandbox-mcp/src/types.ts",
    "node-code-sandbox-mcp/src/utils.ts",
    "node-code-sandbox-mcp/src/runUtils.ts",
    "node-code-sandbox-mcp/src/snapshotUtils.ts",
    "node-code-sandbox-mcp/src/logger.ts",
    "node-code-sandbox-mcp/src/tools/getDependencyTypes.ts"
  ]
}
